# .env.example
# 数据库配置
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/examsphere

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
JWT_SECRET_KEY=your-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600

# Flask 配置
FLASK_ENV=development
SECRET_KEY=your-flask-secret-key

# 日志配置
LOG_LEVEL=INFO
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=30
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_ENABLE_FILE=true
LOG_ENABLE_DATABASE=false
LOG_RETENTION_DAYS=30
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_ERROR_FILE=true
LOG_ENABLE_ROTATION=true

# 邮件配置（163邮箱示例）
MAIL_SERVER=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your-email@163.com
MAIL_PASSWORD=your-smtp-password
# 发件人（可以是 "名称 <email@example.com>" 格式或只有邮箱）
MAIL_DEFAULT_SENDER=your-email@163.com
# 发件人名称（如果MAIL_DEFAULT_SENDER不包含名称）
MAIL_FROM_NAME=ExamSphere系统
# 课程申请邮件收件人（多个邮箱用逗号分隔）
COURSE_APPLICATION_RECIPIENTS=admin1@example.com,admin2@example.com

# 注意：
# - 163邮箱需要使用授权码（不是登录密码），在邮箱设置中开启SMTP服务后获取
# - 465端口使用SSL，587端口使用STARTTLS
# - 如果是Gmail，需要使用应用专用密码，而不是账户密码
